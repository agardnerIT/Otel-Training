# Pinned component versions for the Gateway API exposure layer (ISI-6795).
#
# The casino is exposed with the Gateway API, implemented by kgateway (CNCF,
# Envoy-based — ISI-7546). Bump deliberately and in lockstep: kgateway v2.5.0
# is validated against Gateway API 1.5–1.7 and Kubernetes 1.33–1.37 (see the
# kgateway version-support matrix). We pin the latest Gateway API the installer
# ships (v1.7.0) and kgateway v2.5.0.
export GATEWAY_API_VERSION="${GATEWAY_API_VERSION:-v1.7.0}"
export KGATEWAY_VERSION="${KGATEWAY_VERSION:-v2.5.0}"

# NodePort the casino is exposed on. Must stay inside the default service
# NodePort range (30000-32767) AND inside the band kind-config.yaml publishes
# (30000-30002) + devcontainer.json forwards. Changing this means updating both
# this file AND deploy/casino/k8s/72-gatewayparameters.yaml (the GatewayParameters
# that pins the proxy Service to this NodePort).
export CASINO_HTTP_NODEPORT="${CASINO_HTTP_NODEPORT:-30000}"
