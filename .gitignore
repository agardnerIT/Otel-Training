# local secrets — the filled-in copy of the single canonical .env.sample.
# Keep the sample tracked (/.env.sample); never commit a real .env (ISI-7629).
/.env
.devcontainer/.env

# workshop LLM proxy credential minted by dispense-llm.sh — holds a live key.
.workshop-llm.env

# dtctl Agent Skill installed into the repo tree by install-dtctl-skill.sh when
# the global install path is unavailable (fallback for older dtctl). Generated
# per-attendee at bootstrap — never commit it.
.opencode/

# opencode⇄Gitea secrets (ISI-7711). gitea-token.sh writes ~/.workshop-gitea.env
# and clone-casino.sh writes ~/.git-credentials (both in $HOME); glob them
# defensively in case a copy ever lands inside the tree.
.workshop-gitea.env
.git-credentials

# mkdocs build output
site/
